# ─── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_GROUP_ID=burnout-guardrail
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN               # Uncomment for Confluent Cloud
# KAFKA_SASL_USERNAME=your_api_key
# KAFKA_SASL_PASSWORD=your_api_secret

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=burnout_guardrail
DATABASE_URL=postgresql+asyncpg://guardrail:your_password_here@localhost:5432/burnout_guardrail

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth / SSO (Auth0) ─────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_AUDIENCE=https://api.burnout-guardrail.example.com

# ─── Slack Connector ────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_APP_ID=your_slack_app_id

# ─── Google Calendar Connector ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/google_service_account.json

# ─── Jira Connector ─────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=your_jira_api_token
JIRA_EMAIL=your_email@example.com

# ─── GitHub Connector ───────────────────────────────────────────────────────
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY_PATH=./secrets/github_private_key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_ORG=your_github_org

# ─── ML / Inference ─────────────────────────────────────────────────────────
ML_MODEL_PATH=./ml/models/v1.0/
ML_MODEL_VERSION=1.0

# ─── Notifications ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=alerts@burnout-guardrail.example.com
SLACK_ALERT_CHANNEL=#hr-resilience-alerts
ALERT_CONSECUTIVE_RED_DAYS=3

# ─── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here_minimum_32_characters_long
API_HOST=0.0.0.0
API_PORT=8000
ML_INFERENCE_PORT=8001

# ─── Cloud / Infrastructure ─────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=burnout-guardrail
